[Unit]
Description=Monitoramento de recursos e disponibilidade da AJA
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=6

[Service]
Type=exec
User=aja-monitor
Group=aja-monitor
ExecStart=/usr/local/lib/aja/monitoramento.sh
EnvironmentFile=/etc/aja-monitor.conf
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aja-monitor
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/aja-monitor
UMask=0027

[Install]
WantedBy=multi-user.target
